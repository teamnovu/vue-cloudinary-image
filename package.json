{
  "name": "coliste",
  "type": "module",
  "version": "5.0.0-beta.1",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "run-p -l library:watch playground:dev",
    "library:watch": "pnpm --filter \"vue-cloudinary-image\" watch",
    "library:build": "pnpm --filter \"vue-cloudinary-image\" build",
    "library:publish": "pnpm --filter \"vue-cloudinary-image\" publish",
    "playground:dev": "pnpm --filter \"playground\" dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "pnpm --filter \"*\" type-check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.6.3",
    "@types/node": "^18.19.3",
    "eslint": "^8.56.0",
    "npm-run-all": "^4.1.5",
    "vue": "^3.4.15"
  }
}
