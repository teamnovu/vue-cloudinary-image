{
  "name": "@teamnovu/vue-cloudinary-image",
  "type": "module",
  "version": "5.0.0-beta.1",
  "description": "Simple Cloudinary Image component for vue",
  "author": {
    "name": "novu ag",
    "url": "https://novu.ch"
  },
  "license": "MIT",
  "homepage": "https://github.com/teamnovu/vue-cloudinary-image/tree/main/#readme",
  "repository": {
    "type": "git",
